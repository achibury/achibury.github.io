---
/**
 * /herramientas — placeholder.
 *
 * Pensada para listar el stack con el que trabajas (SIEM, EDR, sandbox,
 * scripts propios). Cuando tengas claro el contenido, si son muchas y
 * cada una necesita su ficha, conviene convertirla en otra colección
 * como la de labs. Si son pocas, con escribirlas acá alcanza.
 */
import Base from '../layouts/Base.astro';
---

<Base titulo="Herramientas" descripcion="Stack y herramientas de trabajo.">
  <div class="contenedor">
    <section class="seccion">
      <h1>Herramientas</h1>
      <p class="intro texto-suave">
        Acá va el stack con el que trabajo: análisis de logs, detección,
        forense y automatización.
      </p>

      <p class="pendiente">Sección en construcción.</p>
    </section>
  </div>
</Base>

<style>
  .intro {
    margin-top: var(--e-4);
    text-wrap: pretty;
  }

  .pendiente {
    margin-top: var(--e-12);
    padding: var(--e-6);
    border: 1px dashed var(--borde);
    border-radius: var(--radio);
    color: var(--texto-suave);
    text-align: center;
  }
</style>
