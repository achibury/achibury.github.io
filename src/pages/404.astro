---
/**
 * Pagina 404.
 *
 * El nombre del archivo importa: Astro la compila a dist/404.html y
 * GitHub Pages la sirve sola cada vez que alguien pide una URL que no
 * existe. No hay que configurar nada mas.
 *
 * Ojo: en `npm run dev` la ves entrando a /404; en produccion aparece
 * automaticamente ante cualquier direccion equivocada.
 */
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <div class="contenedor">
    <section class="seccion">
      <p class="codigo">Error 404</p>
      <h1>Esta página no existe</h1>
      <p class="texto-suave">
        Puede que el enlace esté mal escrito, o que la página haya cambiado
        de dirección.
      </p>
      {/* Dos salidas, no una. /labs va junto al inicio porque es el
          destino mas probable de un enlace roto: una URL de lab que
          cambio de nombre cae justamente aca, y mandar al inicio obliga
          a un salto extra. */}
      <p class="volver">
        <a href="/">Volver al inicio</a>
        <span class="volver__separador" aria-hidden="true">·</span>
        <a href="/labs/">Ver los labs</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .codigo {
    font-family: var(--fuente-mono);
    font-size: var(--t-sm);
    color: var(--texto-suave);
    margin-bottom: var(--e-3);
  }

  .texto-suave {
    margin-top: var(--e-4);
  }

  .volver {
    margin-top: var(--e-8);
  }

  /* Decorativo: separa los dos enlaces sin agregar una palabra que el
     lector de pantalla tenga que leer entre uno y otro. */
  .volver__separador {
    margin-inline: var(--e-2);
    color: var(--texto-suave);
  }
</style>
