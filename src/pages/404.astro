---
/**
 * Pagina 404.
 *
 * El nombre del archivo importa: Astro la compila a dist/404.html y
 * GitHub Pages la sirve sola cada vez que alguien pide una URL que no
 * existe. No hay que configurar nada mas.
 *
 * Ojo: en `npm run dev` la ves entrando a /404; en produccion aparece
 * automaticamente ante cualquier direccion equivocada.
 */
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <div class="contenedor">
    <section class="seccion">
      <p class="codigo">Error 404</p>
      <h1>Esta página no existe</h1>
      <p class="texto-suave">
        Puede que el enlace esté mal escrito, o que la página haya cambiado
        de dirección.
      </p>
      <p class="volver"><a href="/">Volver al inicio</a></p>
    </section>
  </div>
</Base>

<style>
  .codigo {
    font-family: var(--fuente-mono);
    font-size: var(--t-sm);
    color: var(--texto-suave);
    margin-bottom: var(--e-3);
  }

  .texto-suave {
    margin-top: var(--e-4);
  }

  .volver {
    margin-top: var(--e-8);
  }
</style>
