---
/**
 * /sobre-mi — perfil, formación, certificaciones y contacto.
 *
 * Es texto fijo, así que vive directamente en esta página: no necesita
 * colección ni Markdown.
 *
 * Todo lo que hay que reemplazar está marcado con un comentario que
 * empieza con REEMPLAZAR, justo encima del bloque correspondiente.
 * Esos comentarios NO se publican: quedan solo en el código fuente.
 */
import { existsSync } from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';

/**
 * ¿Existe public/cv.pdf?
 *
 * Este codigo corre UNA vez, durante `npm run build`, no en el navegador
 * de quien visita el sitio. Si el archivo no esta, la seccion completa
 * del curriculum no se genera: es preferible a publicar un boton que
 * lleva a un error 404.
 *
 * Para activarla: deja tu PDF en public/cv.pdf y vuelve a compilar.
 */
const hayCV = existsSync(path.join(process.cwd(), 'public', 'cv.pdf'));

/**
 * ¿Mostrar la sección de certificaciones?
 *
 * Hoy está en `false` porque todavía no hay ninguna, y una sección con
 * "Nombre de la certificación · Entidad · Año" de relleno se lee peor
 * que no tener la sección.
 *
 * PARA ACTIVARLA cuando tengas la primera:
 *   1. Cambia esta línea a `true`.
 *   2. Más abajo, en el bloque CERTIFICACIONES, reemplaza los <li> de
 *      ejemplo por los reales. El markup ya está escrito y listo.
 *   3. Si tienes solo certificaciones en curso y ninguna obtenida (o al
 *      revés), borra el <h3> y la <ul> del grupo que te sobre.
 *   4. `npm run build`.
 */
const hayCertificaciones = false;
---

<Base
  titulo="Sobre mí"
  descripcion="Perfil profesional, formación y contacto de Benjamin Achibury."
>
  <div class="contenedor contenedor--centrado">
    <section class="seccion">
      <h1>Sobre mí</h1>
    </section>

    {/* ================= PRESENTACIÓN ================= */}
    <section class="seccion">
      <h2 class="titulo-seccion">Presentación</h2>

      {/* REEMPLAZAR: los tres párrafos de abajo.
          Sugerencia de contenido para cada uno:
            1. Quién eres y en qué estás hoy.
            2. Qué te interesa del blue team y por qué.
            3. Cómo trabajas, o qué busca quien te lea (práctica, memoria,
               primer empleo).
          Con dos párrafos alcanza si el tercero te sale forzado. */}
      <div class="bloque-texto">
        <p>
          Soy estudiante de ingeniería en ciberseguridad en Chile, enfocado en
          seguridad defensiva. Este portafolio reúne los laboratorios que monto
          para aprender, documentados de principio a fin.
        </p>
        <p>
          Me interesa el lado defensivo por una razón concreta: detectar bien es
          más difícil que atacar, porque hay que separar la señal del ruido de
          la operación diaria. Cada lab que publico apunta a esa pregunta.
        </p>
        <p>
          Documento también lo que sale mal. Un lab donde todo funciona a la
          primera enseña menos que uno donde hubo que corregir el rumbo.
        </p>
      </div>
    </section>

    {/* ================= FORMACIÓN ACADÉMICA ================= */}
    <section class="seccion">
      <h2 class="titulo-seccion">Formación académica</h2>

      {/* Para agregar otro programa más adelante, duplica el <li class="ficha">
          entero. Dentro de cada ficha puedes sumar un <p class="texto-suave">
          con la mención o las líneas del plan que quieras destacar. */}
      <ul class="fichas">
        <li class="ficha">
          <h3 class="ficha__titulo">Ingeniería en Ciberseguridad</h3>
          <p class="meta">Instituto Profesional AIEP · 2023 – actualidad</p>
        </li>
      </ul>
    </section>

    {/* ================= CERTIFICACIONES ================= */}
    {/* Oculta mientras `hayCertificaciones` sea false (ver arriba, en el
        bloque --- de esta misma página). El markup de abajo NO se publica,
        queda esperando: cuando tengas la primera certificación, pones la
        bandera en true y reemplazas los <li> de ejemplo. */}
    {
      hayCertificaciones && (
    <section class="seccion">
      <h2 class="titulo-seccion">Certificaciones</h2>

      <div class="bloque-texto">
        <h3 class="subtitulo">Obtenidas</h3>
        <ul class="lista-simple">
          <li>
            Nombre de la certificación
            <span class="meta">· Entidad · Año</span>
          </li>
          <li>
            Nombre de la certificación
            <span class="meta">· Entidad · Año</span>
          </li>
        </ul>

        <h3 class="subtitulo">En curso</h3>
        <ul class="lista-simple">
          <li>
            Nombre de la certificación
            <span class="meta">· Entidad · fecha estimada de rendición</span>
          </li>
        </ul>
      </div>
    </section>
      )
    }

    {/* ================= ÁREAS DE INTERÉS ================= */}
    <section class="seccion">
      <h2 class="titulo-seccion">Áreas de interés</h2>

      {/* REEMPLAZAR: quédate con las que de verdad te interesan y borra el
          resto. Una lista corta y específica dice más que una larga y
          genérica. */}
      <ul class="lista-simple">
        <li>Ingeniería de detección y escritura de reglas (Sigma, YARA)</li>
        <li>Análisis de logs y monitoreo con SIEM</li>
        <li>Respuesta a incidentes y análisis forense (DFIR)</li>
        <li>Threat hunting y modelado de amenazas con MITRE ATT&CK</li>
        <li>Cumplimiento y marcos de referencia (ISO 27001, NIST CSF)</li>
      </ul>
    </section>

    {/* ================= CURRÍCULUM ================= */}
    {/* Esta seccion entera aparece SOLO si existe public/cv.pdf.
        Mientras no dejes el archivo ahi, la pagina se publica sin ella y
        nadie ve un boton roto. No hay que tocar nada de codigo: dejas el
        PDF, compilas, y aparece.

        Antes de subirlo: revisa que el PDF no traiga tu direccion
        particular, tu RUT ni tu telefono, si no quieres que queden
        publicos e indexables. */}
    {
      hayCV && (
        <section class="seccion">
          <h2 class="titulo-seccion">Currículum</h2>
          <p class="texto-suave">
            Versión completa en PDF, con experiencia y detalle de formación.
          </p>
          <p>
            <a class="boton" href="/cv.pdf" download>
              Descargar CV (PDF)
            </a>
          </p>
        </section>
      )
    }

    {/* ================= CONTACTO ================= */}
    <section class="seccion">
      <h2 class="titulo-seccion">Contacto</h2>

      {/* El correo NO se publica como enlace mailto:, que es exactamente
          lo que rastrean los recolectores de spam. Va como texto, partido
          en dos por un <span> y con la arroba escrita como entidad HTML
          (&#64;), así que la dirección completa no aparece como una sola
          cadena en el código fuente de la página.

          El script que está debajo de la lista lo convierte en un enlace
          mailto: funcional al cargar. Si el JavaScript no corre, el correo
          se sigue viendo y se puede copiar: solo deja de ser clickeable. */}
      <ul class="lista-contacto">
        <li>
          <span class="lista-contacto__clave">Correo</span>
          <span class="correo" data-correo>benjamin.achibury<span>&#64;</span>protonmail.com</span>
        </li>
        <li>
          <span class="lista-contacto__clave">LinkedIn</span>
          <a
            class="correo"
            href="https://www.linkedin.com/in/benjamin-achibury/"
            target="_blank"
            rel="noopener noreferrer"
          >linkedin.com/in/benjamin-achibury</a>
        </li>
      </ul>

      {/* Arma el enlace mailto: en el navegador.

          `is:inline` le pide a Astro que lo deje tal cual dentro del HTML
          en vez de empaquetarlo en un .js aparte: son siete líneas y no
          vale la pena una peticion extra por ellas.

          Va DESPUÉS del <ul>, o sea que cuando corre el elemento ya existe
          y no hace falta esperar ningún evento de carga. */}
      <script is:inline>
        document.querySelectorAll('[data-correo]').forEach(function (elemento) {
          var direccion = elemento.textContent.replace(/\s+/g, '');
          if (!direccion) return;
          var enlace = document.createElement('a');
          enlace.href = 'mailto:' + direccion;
          enlace.textContent = direccion;
          enlace.className = elemento.className;
          elemento.replaceWith(enlace);
        });
      </script>
    </section>
  </div>
</Base>

<style>
  /* Centrado del bloque, solo en esta pagina.
     .contenedor ya viene con margin-inline: auto, o sea que siempre esta
     centrado dentro del viewport; lo que pasa es que a 1120px de ancho el
     texto (limitado a 70ch por global.css) queda pegado al borde
     izquierdo y la pagina se ve desbalanceada.

     La solucion es angostar el contenedor hasta la medida de lectura: al
     ser mas angosto, el auto lo centra de verdad. Se le suma el
     padding-inline de los dos lados para que el TEXTO mida exactamente
     70ch (box-sizing: border-box incluye el padding en el max-width).

     El texto sigue alineado a la izquierda: aca no se toca text-align,
     solo se mueve el bloque que lo contiene. */
  .contenedor--centrado {
    max-width: calc(var(--ancho-prosa) + var(--e-6) * 2);
  }

  /* Separación entre párrafos seguidos dentro de una misma sección. */
  .bloque-texto > * + * {
    margin-top: var(--e-4);
  }

  .subtitulo {
    font-size: 1rem;
    margin-top: var(--e-8);
  }

  .bloque-texto > .subtitulo:first-child {
    margin-top: 0;
  }

  /* Fichas de formación: cada una separada por una línea superior, mismo
     tratamiento que las tarjetas de lab para que el sitio se lea parejo. */
  .fichas {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ficha {
    padding-block: var(--e-6);
    border-top: 1px solid var(--borde);
  }

  .ficha__titulo {
    margin: 0 0 var(--e-1);
  }

  .ficha p + p {
    margin-top: var(--e-2);
  }

  .lista-simple {
    margin: 0;
    padding-left: var(--e-6);
  }

  .lista-simple li {
    margin-block: var(--e-2);
  }

  /* Contacto: la etiqueta ("Correo") en una columna fija y el dato al
     lado, para que las filas queden alineadas entre sí. */
  .lista-contacto {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lista-contacto li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-4);
    padding-block: var(--e-3);
    border-top: 1px solid var(--borde);
  }

  /* La direccion de correo es larga y no tiene espacios: sin esto
     desborda el contenedor en pantallas de 360px. */
  .correo {
    overflow-wrap: anywhere;
  }

  .lista-contacto__clave {
    flex: 0 0 6rem;
    font-size: 0.875rem;
    color: var(--texto-suave);
  }

  /* Botón de descarga. Usa el acento, igual que la píldora de categoría
     de los labs: es la misma familia visual. */
  .boton {
    display: inline-block;
    margin-top: var(--e-4);
    padding: var(--e-3) var(--e-6);
    border: 1px solid var(--acento);
    border-radius: var(--radio);
    background: var(--acento-fondo);
    color: var(--acento);
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
  }

  .boton:hover {
    background: var(--acento);
    color: var(--fondo);
  }
</style>
