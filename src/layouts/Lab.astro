---
/**
 * Layout de la página de detalle de un lab.
 *
 * Recibe el lab entero, arma la cabecera (título, fecha, categoría,
 * herramientas, técnicas MITRE) y deja un <slot /> donde se inserta el
 * Markdown ya convertido a HTML.
 *
 * Los estilos del contenido Markdown están al final: como ese HTML lo
 * genera Astro y no lo escribimos nosotros, hay que estilarlo con
 * :global() desde el contenedor .prosa.
 */
import Base from './Base.astro';
import type { Lab } from '../lib/labs';
import { ETIQUETAS_CATEGORIA, ETIQUETAS_FUNCION, formatearFecha } from '../lib/labs';

interface Props {
  lab: Lab;
}

const { lab } = Astro.props;
const { titulo, resumen, fecha, categoria, herramientas, mitre_attack, funcion, borrador } =
  lab.data;
---

<Base titulo={titulo} descripcion={resumen}>
  <article class="contenedor">
    <header class="cabecera">
      {
        borrador && (
          <p class="aviso">
            Borrador. Visible solo en desarrollo: no se publica en el sitio.
          </p>
        )
      }

      <div class="cabecera__meta">
        <span class="etiqueta etiqueta--acento">{ETIQUETAS_CATEGORIA[categoria]}</span>
        <time class="meta" datetime={fecha.toISOString()}>{formatearFecha(fecha)}</time>
      </div>

      <h1>{titulo}</h1>
      <p class="cabecera__resumen texto-suave">{resumen}</p>

      {
        /* Las dos listas solo aparecen si el frontmatter las trae.
           Un lab sin técnicas MITRE no muestra un bloque vacío. */
        herramientas.length > 0 && (
          <div class="cabecera__grupo cabecera__grupo--herramientas">
            <h2 class="titulo-seccion">Herramientas</h2>
            <ul class="lista-etiquetas">
              {herramientas.map((h) => (
                <li class="etiqueta">{h}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        /* mitre_attack y funcion son opcionales en el schema: pueden
           llegar como undefined, no solo como lista vacia. Por eso se
           comprueba primero que existan (`mitre_attack &&`) antes de
           mirar su largo: sin esa guarda, un lab que no los declara
           reventaria al construir la pagina. */
        mitre_attack && mitre_attack.length > 0 && (
          <div class="cabecera__grupo cabecera__grupo--mitre">
            <h2 class="titulo-seccion">MITRE ATT&CK</h2>
            <ul class="lista-etiquetas">
              {mitre_attack.map((t) => (
                <li class="etiqueta">{t}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        funcion && funcion.length > 0 && (
          <div class="cabecera__grupo cabecera__grupo--funcion">
            <h2 class="titulo-seccion">Función</h2>
            <ul class="lista-etiquetas">
              {funcion.map((f) => (
                <li class="etiqueta">{ETIQUETAS_FUNCION[f]}</li>
              ))}
            </ul>
          </div>
        )
      }
    </header>

    <div class="prosa">
      <slot />
    </div>

    <p class="volver"><a href="/labs/">← Todos los labs</a></p>
  </article>
</Base>

<style>
  .cabecera {
    padding-bottom: var(--e-8);
    border-bottom: 1px solid var(--borde);
    margin-bottom: var(--e-8);
  }

  .cabecera__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3);
    margin-bottom: var(--e-4);
  }

  .cabecera__resumen {
    margin-top: var(--e-3);
    font-size: var(--t-md);
  }

  /* --- Grupos de etiquetas ---
     Cada grupo (rótulo + chips) tiene que leerse como UNA unidad. Para
     eso el rótulo va pegado a sus chips (margen chico abajo) y el aire
     grande se reserva para separar un grupo del siguiente. El borde
     izquierdo ata las dos líneas entre sí y, de paso, distingue los
     grupos por color. */
  .cabecera__grupo {
    margin-top: var(--e-8);
    padding-left: var(--e-3);
    border-left: 2px solid var(--borde);
  }

  .cabecera__grupo .titulo-seccion {
    margin-bottom: var(--e-2);
  }

  /* Los tres grupos se distinguen por color Y por trazo, no solo por
     color. Hay dos razones concretas:

       1. En modo oscuro el acento (#5eead4) y el texto principal
          (#e2e8f0) quedan a 1.20:1 de contraste entre sí: dos barras de
          2px con esos colores se verían prácticamente iguales. Medido,
          no supuesto.
       2. Confiar solo en el color deja fuera a quien no distingue tonos.

     De ahí la combinación: acento sólido / neutro sólido / neutro
     punteado. Se leen distinto en los dos modos y sin depender de la
     percepción del color. */
  .cabecera__grupo--herramientas {
    border-left-color: var(--acento);
  }

  .cabecera__grupo--mitre {
    border-left-color: var(--texto-suave);
  }

  .cabecera__grupo--funcion {
    border-left-style: dashed;
    border-left-color: var(--texto-suave);
  }

  .aviso {
    margin: 0 0 var(--e-6);
    padding: var(--e-3) var(--e-4);
    border: 1px dashed var(--borde);
    border-radius: var(--radio);
    background: var(--superficie);
    color: var(--texto-suave);
    font-size: var(--t-sm);
  }

  .volver {
    margin-top: var(--e-16);
    padding-top: var(--e-6);
    border-top: 1px solid var(--borde);
    font-size: var(--t-sm);
  }

  /* --- Contenido del lab (el HTML que sale del Markdown) ---
     :global() es necesario porque este HTML no está escrito en este
     archivo: lo genera Astro al convertir el .md, así que no lleva las
     clases automáticas de Astro. Está acotado a .prosa, o sea que no
     se escapa al resto del sitio. */

  /* ======================================================================
     ENCABEZADOS DE SECCIÓN DEL LAB

     Cada nivel se distingue por VARIAS señales a la vez, no solo por
     tamaño. Distinguir por tamaño obliga a comparar dos encabezados
     conscientemente para saber cuál manda; combinar señales deja
     reconocer el nivel de un vistazo, sin detenerse a leer.

                tamaño   peso   color            señal propia
       h2       28px     650    --texto          línea separadora arriba
       h3       21px     550    --texto-medio    barra de acento a la izq.
       cuerpo   16px     400    --texto          --
     ====================================================================== */

  .prosa :global(h2) {
    margin-top: var(--h2-arriba);
    margin-bottom: var(--h2-abajo);
    padding-top: var(--h2-aire-linea);
    border-top: 1px solid var(--borde);
    color: var(--texto);
  }

  /* El primer encabezado no necesita separarse de nada: viene justo
     después de la cabecera del lab, que ya trae su propia línea. */
  .prosa > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  /* El h3 baja de peso Y de color respecto al h2. Las dos cosas juntas
     lo dejan leíble como subordinado sin necesidad de compararlo con
     nada: 550 contra 650 de peso, y --texto-medio contra --texto. */
  .prosa :global(h3) {
    position: relative;
    margin-top: var(--h3-arriba);
    margin-bottom: var(--h3-abajo);
    font-weight: 550;
    color: var(--texto-medio);
  }

  /* Marcador de posición del h3: una barra corta de acento, del alto
     del texto, que ancla el encabezado a su bloque. Sirve para escanear
     la página: los h3 se detectan sin leerlos.

     Va colgando FUERA de la columna de texto (left negativo) para que el
     h3 siga alineado con el cuerpo; si usara border-left, el texto se
     correría a la derecha y rompería esa alineación. El desplazamiento
     cae dentro del padding del contenedor, así que no desborda ni en
     pantallas de 360px.

     El h2 NO lleva marcador: ya tiene su línea separadora, y sumarle
     una segunda señal lo acercaría visualmente al h3 en vez de
     distinguirlo. */
  .prosa :global(h3)::before {
    content: '';
    position: absolute;
    left: calc(var(--e-3) * -1);
    top: 0.22em;
    width: 3px;
    height: 0.95em;
    border-radius: 2px;
    background: var(--acento);
  }

  /* --- Lo que sigue a un encabezado ---
     No aporta su propio margen de arriba: el único hueco que manda es el
     margen de abajo del encabezado. Es lo que lo mantiene pegado a su
     contenido.

     OJO CON LA ESPECIFICIDAD. `.prosa p`, `.prosa pre` y `.prosa table`
     traen `margin-block`, que también fija el margen de arriba, y tienen
     la MISMA especificidad que una regla `h3 + *`. La versión anterior
     usaba `h3 + *` y quedaba declarada antes que ellas, o sea que las
     otras ganaban por orden: el hueco bajo un h3 seguido de un bloque de
     código era de 24px en vez de 8px, y el encabezado flotaba entre su
     sección y la anterior.

     Nombrar los dos lados con :is() suma un elemento más al selector y
     gana por especificidad, sin depender de dónde quede escrita. */
  .prosa
    :global(:is(h2, h3) + :is(p, ul, ol, pre, table, blockquote, figure, hr)) {
    margin-top: 0;
  }

  /* --- Encabezados consecutivos ---
     Dos casos que el ritmo normal resuelve mal:

       h2 + h3  el h3 no debe acumular su margen grande encima del que ya
                puso el h2; queda pegado, como subtítulo de la sección.
       h3 + h3  sin esto el segundo quedaría pegado al primero.

     Un h2 después de cualquier cosa conserva su tratamiento completo
     (línea + margen grande): siempre es un corte mayor. */
  .prosa :global(h2 + h3) {
    margin-top: var(--h3-tras-h2);
  }

  .prosa :global(h3 + h3) {
    margin-top: var(--h3-tras-h3);
  }

  .prosa :global(p),
  .prosa :global(ul),
  .prosa :global(ol) {
    margin-block: var(--e-4);
  }

  .prosa :global(ul),
  .prosa :global(ol) {
    padding-left: var(--e-6);
  }

  .prosa :global(li) {
    margin-block: var(--e-2);
  }

  .prosa :global(pre) {
    margin-block: var(--e-6);
  }

  /* --- Imágenes del lab ---
     Viven en src/assets/labs/<slug>/ y se referencian con ruta relativa
     desde el .md, para que Astro las procese (WebP, dimensiones, carga
     diferida). Ver "Capturas e imágenes de un lab" en CLAUDE.md:
       ![Texto alternativo](../../assets/labs/mi-lab/captura.png)

     Las capturas tienen proporciones muy distintas: una salida de
     terminal es ancha y baja (1300x140), un diagrama de topología es
     casi cuadrado (577x439). Antes esto usaba `width: 100%`, que forzaba
     a TODAS al ancho del contenedor: el diagrama se estiraba de 577 a
     1072px, o sea que quedaba de 818px de alto Y ampliado, borroso.

     Ahora manda el tamaño natural, acotado por dos topes:
       max-width: 100%             no se sale del contenedor
       max-height: --lab-imagen-alto  no se come la pantalla

     Con `width` y `height` en auto, el navegador respeta la proporción
     al aplicar cualquiera de los dos topes: no deforma ni recorta, solo
     escala. Las anchas y bajas no se ven afectadas, porque el que las
     limita sigue siendo el ancho. */
  .prosa :global(figure) {
    margin: var(--e-8) 0;
  }

  .prosa :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--lab-imagen-alto);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }

  .prosa :global(figcaption),
  .prosa :global(img + em) {
    display: block;
    margin-top: var(--e-2);
    font-size: var(--t-sm);
    color: var(--texto-suave);
  }

  /* --- Bloque de hallazgo ---
     En un lab el blockquote NO es una cita: marca el hallazgo clave de
     una sección. Qué arrojó un escaneo, la evidencia de que un control
     quedó funcionando. Antes se veía casi igual que un párrafo (mismo
     tamaño, y encima atenuado con --texto-suave) y esos hallazgos
     pasaban desapercibidos al escanear la página.

     Tres señales: fondo propio, barra de acento y tamaño intermedio.

     Lo del tamaño es deliberado: 18px queda por encima del cuerpo (16px)
     y por debajo del h3 (21px). Destaca al escanear sin competir con la
     estructura de encabezados ni parecer un título.

     Y el color del texto vuelve a --texto: atenuarlo era justamente lo
     que lo hacía desaparecer.

     Contraste del texto sobre el fondo: 16.21:1 en claro, 10.00:1 en
     oscuro. Los dos muy por encima del mínimo 4.5:1. */
  .prosa :global(blockquote) {
    /* margin-inline: 0 NO es redundante.
       El navegador le aplica al blockquote un `margin-inline: 40px` por
       su cuenta, en su hoja de estilos por defecto. Fijar solo
       `margin-block` deja ese valor vivo, y el bloque arranca 40px a la
       derecha del párrafo y del bloque de código que tiene al lado.
       Con esto el borde izquierdo del bloque queda alineado con el del
       resto del cuerpo del lab. */
    margin-block: var(--e-6);
    margin-inline: 0;

    padding: var(--e-3) var(--e-4);
    border-left: 2px solid var(--acento);
    border-radius: 0 var(--radio) var(--radio) 0;
    background: var(--hallazgo-fondo);
    color: var(--texto);

    /* Mismo tamaño que el cuerpo. Lo que lo hace destacar es el fondo y
       la barra de acento, no el tamaño: a 18px competía con el h3 (21px)
       y el ojo lo leía como si fuera otro nivel de encabezado. */
    font-size: var(--t-base);
  }

  /* El primer y el último párrafo de adentro no aportan margen propio:
     el padding del bloque ya da todo el aire que hace falta. Sin esto el
     bloque queda con el doble de espacio arriba y abajo del texto. */
  .prosa :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .prosa :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .prosa :global(hr) {
    margin-block: var(--e-12);
    border: 0;
    border-top: 1px solid var(--borde);
  }

  .prosa :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--e-6);
    font-size: var(--t-sm);
  }

  .prosa :global(th),
  .prosa :global(td) {
    text-align: left;
    padding: var(--e-2) var(--e-3);
    border-bottom: 1px solid var(--borde);
  }

  .prosa :global(th) {
    font-weight: 600;
  }

  /* --- Bloques anchos ---
     El texto del lab queda limitado a la medida de lectura por la regla
     de global.css. Estos tres se liberan de ese límite y pueden ocupar
     hasta el ancho del contenedor:

       - los bloques de código (pre)
       - las tablas
       - los párrafos que contienen una imagen

     Markdown envuelve las imágenes en un <p>, así que hay que soltar ese
     párrafo (:has(img)) y no la imagen: si solo soltáramos la imagen,
     seguiría encerrada en un padre de 70ch. */
  .prosa :global(pre),
  .prosa :global(table),
  .prosa :global(figure),
  .prosa :global(p:has(img)) {
    max-width: none;
  }
</style>
