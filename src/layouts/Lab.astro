---
/**
 * Layout de la página de detalle de un lab.
 *
 * Recibe el lab entero, arma la cabecera (título, fecha, categoría,
 * herramientas, técnicas MITRE) y deja un <slot /> donde se inserta el
 * Markdown ya convertido a HTML.
 *
 * Los estilos del contenido Markdown están al final: como ese HTML lo
 * genera Astro y no lo escribimos nosotros, hay que estilarlo con
 * :global() desde el contenedor .prosa.
 */
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import TablaContenidos from '../components/TablaContenidos.astro';
import type { Lab } from '../lib/labs';
import { ETIQUETAS_CATEGORIA, ETIQUETAS_FUNCION, formatearFecha } from '../lib/labs';
import { AUTOR } from '../lib/sitio';

interface Props {
  lab: Lab;
  /**
   * Encabezados de la tabla de contenidos, YA filtrados por
   * `encabezadosParaTOC()`. Llegan desde [...id].astro, que es donde
   * se llama a `render()`. Si viene vacia, este lab no lleva barra y
   * la pagina se arma a una sola columna.
   */
  encabezados: MarkdownHeading[];
}

const { lab, encabezados } = Astro.props;
const hayTOC = encabezados.length > 0;
const {
  titulo,
  resumen,
  fecha,
  actualizado,
  categoria,
  herramientas,
  mitre_attack,
  funcion,
  borrador,
} = lab.data;

/**
 * Datos estructurados del lab (schema.org TechArticle).
 *
 * TechArticle es el subtipo para contenido técnico, más preciso que
 * Article a secas. Todo sale del frontmatter y de `Astro.site`: no hay
 * ningún valor escrito a mano acá.
 *
 * Las URLs son absolutas porque los buscadores leen el JSON-LD fuera del
 * contexto de la página y una ruta relativa no significa nada ahí. Se
 * arman igual que el canonical de Base.astro, con `Astro.site`.
 *
 * `datePublished` va como fecha sola (2026-03-14) y no con hora: el
 * frontmatter solo trae la fecha, y un `toISOString()` completo
 * afirmaría una hora y una zona que nadie escribió.
 *
 * `dateModified` sale del campo opcional `actualizado` y SOLO aparece si
 * el lab lo declara. No se rellena con la fecha del build: eso afirmaría
 * que el lab se modificó cada vez que se compila el sitio.
 */
const urlLab = new URL(Astro.url.pathname, Astro.site);
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: titulo,
  description: resumen,
  datePublished: fecha.toISOString().slice(0, 10),
  // Solo si el lab declara `actualizado` en el frontmatter.
  ...(actualizado ? { dateModified: actualizado.toISOString().slice(0, 10) } : {}),
  inLanguage: 'es',
  url: urlLab.href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': urlLab.href },
  image: new URL('/og.png', Astro.site).href,
  author: {
    '@type': 'Person',
    name: AUTOR,
    url: new URL('/sobre-mi/', Astro.site).href,
  },
  // Solo si el lab declara herramientas: un keywords vacío no aporta.
  ...(herramientas.length > 0 ? { keywords: herramientas.join(', ') } : {}),
};
---

{/* En producción los borradores no generan página, pero en
    `npm run dev` sí se muestran: el guardado evita emitir datos
    estructurados de algo que no está publicado. */}
<Base
  titulo={titulo}
  descripcion={resumen}
  tipoOG="article"
  datosEstructurados={borrador ? undefined : datosEstructurados}
>
  <article class:list={['contenedor', 'lab', { 'lab--con-toc': hayTOC }]}>
    <header class="cabecera">
      {
        borrador && (
          <p class="aviso">
            Borrador. Visible solo en desarrollo: no se publica en el sitio.
          </p>
        )
      }

      <div class="cabecera__meta">
        <span class="etiqueta etiqueta--acento">{ETIQUETAS_CATEGORIA[categoria]}</span>
        <time class="meta" datetime={fecha.toISOString()}>{formatearFecha(fecha)}</time>
      </div>

      <h1>{titulo}</h1>
      <p class="cabecera__resumen texto-suave">{resumen}</p>

      {
        /* Las dos listas solo aparecen si el frontmatter las trae.
           Un lab sin técnicas MITRE no muestra un bloque vacío. */
        herramientas.length > 0 && (
          <div class="cabecera__grupo cabecera__grupo--herramientas">
            <p class="titulo-seccion" id="rotulo-herramientas">Herramientas</p>
            <ul class="lista-etiquetas" aria-labelledby="rotulo-herramientas">
              {herramientas.map((h) => (
                <li class="etiqueta">{h}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        /* mitre_attack y funcion son opcionales en el schema: pueden
           llegar como undefined, no solo como lista vacia. Por eso se
           comprueba primero que existan (`mitre_attack &&`) antes de
           mirar su largo: sin esa guarda, un lab que no los declara
           reventaria al construir la pagina. */
        mitre_attack && mitre_attack.length > 0 && (
          <div class="cabecera__grupo cabecera__grupo--mitre">
            <p class="titulo-seccion" id="rotulo-mitre">MITRE ATT&CK</p>
            <ul class="lista-etiquetas" aria-labelledby="rotulo-mitre">
              {mitre_attack.map((t) => (
                <li class="etiqueta">{t}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        funcion && funcion.length > 0 && (
          <div class="cabecera__grupo cabecera__grupo--funcion">
            <p class="titulo-seccion" id="rotulo-funcion">Función</p>
            <ul class="lista-etiquetas" aria-labelledby="rotulo-funcion">
              {funcion.map((f) => (
                <li class="etiqueta">{ETIQUETAS_FUNCION[f]}</li>
              ))}
            </ul>
          </div>
        )
      }
    </header>

    {/* Va ANTES de la prosa en el HTML aunque en escritorio se dibuje a
        la derecha. Es el orden correcto en los dos usos que importan:
        en movil se lee el indice antes del articulo, y con teclado el
        Tab llega a los enlaces de seccion antes de entrar al cuerpo,
        que es justamente para lo que sirve un indice. */}
    <TablaContenidos encabezados={encabezados} />

    <div class="prosa">
      <slot />
    </div>

    <p class="volver"><a href="/labs/">← Todos los labs</a></p>

    {/* --- Marcado de la seccion que se esta leyendo ---

        Es la UNICA parte de la tabla de contenidos que necesita
        JavaScript. Todo lo demas (desplegarse en movil, navegar con
        teclado, saltar a la seccion, quedar fija al costado) ya
        funciona sin esto.

        Cero dependencias y va en linea, igual que el script del correo
        de /sobre-mi: son ~30 lineas, y un archivo aparte costaria una
        peticion HTTP mas que pesa mas que el propio codigo.

        Se emite en TODOS los labs, tambien en los que no llevan barra:
        ahi `lista` no existe y sale por la primera linea. Podria
        emitirse condicionalmente, pero un <script is:inline> metido en
        una expresion de Astro se parsea como JSX y los `<` de las
        comparaciones lo romperian. No vale la pena por 300 bytes. */}
    <script is:inline>
      (function () {
        var lista = document.querySelector('.toc__lista');
        if (!lista) return;

        /* Cada enlace con su encabezado. El `decodeURIComponent` no
           sobra: los slugs llevan tildes (lo que se ve como
           "#linea-base" es en realidad "#línea-base") y `a.hash` los
           devuelve percent-encoded. */
        var porSeccion = new Map();
        var secciones = [];
        Array.prototype.forEach.call(lista.querySelectorAll('a[href^="#"]'), function (a) {
          var h = document.getElementById(decodeURIComponent(a.hash.slice(1)));
          if (!h) return;
          porSeccion.set(h, a);
          secciones.push(h);
        });
        if (!secciones.length) return;

        var activo = null;
        function activar(a) {
          if (a === activo) return;
          if (activo) activo.removeAttribute('aria-current');
          /* "location" y no "page": el enlace del header ya usa "page"
             para decir en que pagina estas. Esto marca una posicion
             DENTRO de la pagina, que es lo que significa "location". */
          if (a) a.setAttribute('aria-current', 'location');
          activo = a;
        }

        /* La seccion activa es la ultima cuyo encabezado quedo por
           encima del 20% del alto de la ventana. Se recalcula entera en
           vez de mirar que entradas cruzaron: asi da igual en que orden
           lleguen, funciona al cargar la pagina ya desplazada y no hay
           que acordarse de cual estaba activa antes.

           Es la UNICA fuente de verdad: los tres disparadores de mas
           abajo no deciden nada por su cuenta, solo la llaman. */
        function recalcular() {
          /* Al fondo del documento gana siempre la ultima seccion.

             Sin esto la ultima no se marca NUNCA cuando lo que cuelga
             de ella mide menos del 80% de la ventana: su encabezado no
             alcanza a subir hasta la franja porque no hay contenido
             abajo que lo empuje, y la pagina se termina antes. */
          var doc = document.documentElement;
          if (window.innerHeight + window.scrollY >= doc.scrollHeight - 2) {
            activar(porSeccion.get(secciones[secciones.length - 1]));
            return;
          }

          var limite = window.innerHeight * 0.2;
          var ultima = null;
          for (var i = 0; i < secciones.length; i++) {
            if (secciones[i].getBoundingClientRect().top < limite) ultima = secciones[i];
          }
          activar(ultima ? porSeccion.get(ultima) : null);
        }

        /* --- Disparador 1: cruzar la linea del 20% ---

           El rootMargin arma una region que va desde MUY arriba de la
           ventana hasta el 20% de su alto. O sea que un encabezado
           "intersecta" exactamente mientras esta por encima de esa
           linea, que es la misma condicion que usa recalcular().

           OJO: el 20% de `recalcular()` y el -80% de aca son el mismo
           numero visto de dos maneras. Si cambias uno, cambia el otro.

           NO uses una franja fina (algo como '-15% 0px -75% 0px').
           Parece mas prolijo y da histeresis, pero tiene un agujero:
           esa franja mide ~90px, y un fotograma de scroll rapido
           —una pasada de trackpad, Av Pag, arrastrar la barra— avanza
           mucho mas que eso. El encabezado ATRAVIESA la franja sin
           quedar nunca adentro, el estado va de "fuera" a "fuera", y
           el observador no dispara: el indice se queda clavado en la
           seccion anterior. Medido: 7000px de scroll sin que el item
           activo se moviera.

           Con una region enorme eso no puede pasar, porque el cambio
           de estado no depende de caer dentro de nada: basta con
           cruzar la linea. Los 9999px de arriba son eso, "todo lo que
           haya por encima".

           Se pierde la histeresis, y esta bien: solo importaria con un
           encabezado detenido justo sobre la linea, y el scroll
           quieto no tiembla.

           Ademas dispara una vez al empezar a observar, asi que si
           entras con un #ancla o recargas a media pagina, el item
           correcto queda marcado de entrada. */
        var io = new IntersectionObserver(recalcular, {
          rootMargin: '9999px 0px -80% 0px',
        });
        secciones.forEach(function (h) {
          io.observe(h);
        });

        /* --- Disparador 2: el fondo del documento ---
           Un centinela de 1px al final del <body>. Entra en la ventana
           exactamente cuando el documento llega a su ultimo pixel, o
           sea al tocar fondo, y vuelve a salir al subir.

           Solo DISPARA el recalculo; quien decide es recalcular(), que
           vuelve a comprobar la posicion por su cuenta. Asi no hay dos
           versiones de "estoy al fondo" que se puedan contradecir.

           Va al final del <body> y no al final del articulo a proposito:
           abajo del articulo todavia esta el footer, asi que un
           centinela ahi se activaria antes de llegar al fondo. */
        var centinela = document.createElement('div');
        centinela.setAttribute('aria-hidden', 'true');
        centinela.style.height = '1px';
        document.body.appendChild(centinela);
        new IntersectionObserver(recalcular).observe(centinela);

        /* --- Disparador 3: el clic en un item ---
           Al saltar a una seccion, el encabezado destino aterriza POR
           ENCIMA de la franja (a la altura del scroll-margin-top), asi
           que NO la cruza: el observador no se entera y el indice sigue
           marcando la seccion de donde veniamos.

           Marcarlo aca no pelea con el observador. Es exactamente la
           misma respuesta que daria recalcular() en esa posicion —el
           destino queda por encima del limite y todo lo que sigue por
           debajo—, solo que llega de inmediato en vez de esperar un
           cruce que no va a ocurrir. Si despues el usuario mueve el
           scroll, el observador retoma sin nada que deshacer.

           Va en la lista y no en cada enlace: un solo escucha, y cubre
           tanto el clic como el Enter del teclado, que dispara el mismo
           evento. */
        lista.addEventListener('click', function (e) {
          var enlace = e.target.closest('a[href^="#"]');
          if (enlace) activar(enlace);
        });
      })();
    </script>
  </article>
</Base>

<style>
  /* ======================================================================
     DOS COLUMNAS: ARTICULO + TABLA DE CONTENIDOS

     Solo se activa si el lab lleva barra (.lab--con-toc). Sin ella la
     pagina queda como estaba, a una columna: nada de reservar 240px
     vacios al costado.

     El punto de corte no es un tamaño de moda, sale de una cuenta. La
     columna del articulo tiene que seguir aguantando el bloque de
     codigo mas ancho del lab: 707px medidos en el navegador (clonando
     el <pre> con width: max-content). Como la columna vale
     "ventana - 48 de relleno - 288 de barra - 48 de separacion", hace
     falta una ventana de 1091px. 69rem son 1104px y dejan 720px de
     columna, con margen. Comprobado que ninguno de los 18 bloques de
     codigo del lab desborda.

     Si tocas --toc-ancho, este numero se mueve con el: son la misma
     cuenta. Por eso van comentados los dos.

     Por debajo de eso la barra vuelve a ser el <details> desplegable
     arriba del articulo, que es como se ve en movil.

     POR QUE A LA IZQUIERDA: se lee de izquierda a derecha, asi que el
     ojo encuentra el indice antes de entrar al texto, y de paso el
     final de cada linea queda libre en vez de competir con la barra.

     El costo es que el articulo se corre 336px respecto del header y
     del footer, que siguen en el borde del contenedor. La pagina queda
     entonces con DOS bordes verticales en vez de uno:

       184px  marca del header, indice, footer   (el marco del sitio)
       520px  chips, h1, resumen y cuerpo        (el articulo entero)

     Los dos son limpios y cada uno es consistente consigo mismo. Eso es
     lo que hay que defender: ver el punto 11 de NO TOCAR, porque hay
     una forma muy facil de romperlo sin darse cuenta.
     ====================================================================== */
  @media (min-width: 69rem) {
    .lab--con-toc {
      display: grid;
      /* minmax(0, 1fr) y NO 1fr a secas. Un `1fr` pelado tiene como
         minimo automatico el min-content de lo que contenga, y aca
         adentro hay tablas y bloques de codigo con lineas larguisimas
         que no envuelven: la columna se estiraria hasta el ancho de la
         linea mas larga y le meteria scroll horizontal a la pagina
         entera. El minmax(0, ...) le permite achicarse. */
      grid-template-columns: var(--toc-ancho) minmax(0, 1fr);
      column-gap: var(--e-12);
      /* start, no el stretch de fabrica: un item estirado ocupa toda la
         altura de su fila, y entonces `position: sticky` no tiene por
         donde moverse. Es lo que hace que la barra siga el scroll de
         verdad en vez de quedarse quieta arriba. */
      align-items: start;
    }

    /* LA CABECERA VA EN LA COLUMNA 2, junto con la prosa. NO cruza las
       dos columnas. Es la regla que sostiene todo el diseño y la que
       mas facil se rompe: ver NO TOCAR punto 11.

       Si cruza, se ancla al borde del contenedor (184px) mientras su
       propio primer parrafo se va con la prosa (520px), y el h1 queda
       desalineado de su propio cuerpo por 336px. El corte no aparece
       contra el header: aparece DENTRO del articulo, que se ve mucho
       peor. Medido: con la cabecera en la columna 2, el h1 y su primer
       parrafo comparten los 520px exactos. */
    .lab--con-toc .cabecera {
      grid-area: 1 / 2;
    }

    .lab--con-toc .prosa {
      grid-area: 2 / 2;
    }

    .lab--con-toc .volver {
      grid-column: 2;
    }

    /* :global() porque .toc se declara en TablaContenidos.astro y lleva
       el hash de ESE componente, no el de este archivo. Va acotado a
       .lab--con-toc, que si esta scopeado, asi que no se escapa. */
    .lab--con-toc > :global(.toc) {
      /* Fila 1 a 3, o sea que ABARCA LAS DOS FILAS de la rejilla.
         No es para estirar la barra —mide lo que mide— sino porque
         `position: sticky` solo puede desplazarse dentro de su area de
         rejilla. Puesta solo en la fila 1, su area seria el alto de la
         cabecera y la barra se despegaria despues de ~400px de scroll.

         Y arranca ARRIBA, al costado de la cabecera, y no debajo de
         ella: debajo funciona igual pero deja ~400px vacios en la
         esquina superior izquierda, que es la parte mas valiosa de la
         primera pantalla, y empuja el indice por debajo del pliegue. */
      grid-area: 1 / 1 / 3 / 2;
      position: sticky;
      top: var(--e-8);
      /* Red de seguridad para un lab futuro con muchas secciones: con
         8 items la barra mide 221px y esto no llega a actuar nunca. */
      max-height: calc(100vh - var(--e-16));
      overflow-y: auto;
    }
  }

  .cabecera {
    padding-bottom: var(--e-8);
    border-bottom: 1px solid var(--borde);
    margin-bottom: var(--e-8);
  }

  .cabecera__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3);
    margin-bottom: var(--e-4);
  }

  .cabecera__resumen {
    margin-top: var(--e-3);
    font-size: var(--t-md);
  }

  /* --- Grupos de etiquetas ---
     Cada grupo (rótulo + chips) tiene que leerse como UNA unidad. Para
     eso el rótulo va pegado a sus chips (margen chico abajo) y el aire
     grande se reserva para separar un grupo del siguiente. El borde
     izquierdo ata las dos líneas entre sí y, de paso, distingue los
     grupos por color. */
  .cabecera__grupo {
    margin-top: var(--e-8);
    padding-left: var(--e-3);
    border-left: 2px solid var(--borde);
  }

  .cabecera__grupo .titulo-seccion {
    margin-bottom: var(--e-2);
  }

  /* Los tres grupos se distinguen por color Y por trazo, no solo por
     color. Hay dos razones concretas:

       1. En modo oscuro el acento (#5eead4) y el texto principal
          (#e2e8f0) quedan a 1.20:1 de contraste entre sí: dos barras de
          2px con esos colores se verían prácticamente iguales. Medido,
          no supuesto.
       2. Confiar solo en el color deja fuera a quien no distingue tonos.

     De ahí la combinación: acento sólido / neutro sólido / neutro
     punteado. Se leen distinto en los dos modos y sin depender de la
     percepción del color. */
  .cabecera__grupo--herramientas {
    border-left-color: var(--acento);
  }

  .cabecera__grupo--mitre {
    border-left-color: var(--texto-suave);
  }

  .cabecera__grupo--funcion {
    border-left-style: dashed;
    border-left-color: var(--texto-suave);
  }

  .aviso {
    margin: 0 0 var(--e-6);
    padding: var(--e-3) var(--e-4);
    border: 1px dashed var(--borde);
    border-radius: var(--radio);
    background: var(--superficie);
    color: var(--texto-suave);
    font-size: var(--t-sm);
  }

  .volver {
    margin-top: var(--e-16);
    padding-top: var(--e-6);
    border-top: 1px solid var(--borde);
    font-size: var(--t-sm);
  }

  /* --- Contenido del lab (el HTML que sale del Markdown) ---
     :global() es necesario porque este HTML no está escrito en este
     archivo: lo genera Astro al convertir el .md, así que no lleva las
     clases automáticas de Astro. Está acotado a .prosa, o sea que no
     se escapa al resto del sitio. */

  /* ======================================================================
     ENCABEZADOS DE SECCIÓN DEL LAB

     Cada nivel se distingue por VARIAS señales a la vez, no solo por
     tamaño. Distinguir por tamaño obliga a comparar dos encabezados
     conscientemente para saber cuál manda; combinar señales deja
     reconocer el nivel de un vistazo, sin detenerse a leer.

                tamaño   peso   color            señal propia
       h2       28px     650    --texto          línea separadora arriba
       h3       21px     550    --texto-medio    barra de acento a la izq.
       cuerpo   16px     400    --texto          --
     ====================================================================== */

  /* --- Aterrizaje de los enlaces del indice ---
     Sin esto, al saltar a #una-seccion el encabezado queda pegado al
     borde de arriba de la ventana y se lee como si fuera el final de la
     seccion anterior. El header de este sitio NO es fijo (no hay un
     solo `position` en Header.astro), asi que no hay que compensar su
     alto: alcanza con un respiro.

     Va tambien en el h3 aunque el indice solo liste h2, porque los h3
     igual tienen id y se pueden enlazar directo. */
  .prosa :global(:is(h2, h3)) {
    scroll-margin-top: var(--e-6);
  }

  /* NO agregues un resaltado `:target` en los encabezados. Estuvo y se
     quito: `:target` no se limpia solo, asi que el encabezado quedaba
     pintado hasta navegar a otra ancla, y el aria-current de la barra
     ya dice donde estas de una forma que SI se actualiza. */

  /* La linea separadora usa --chip-borde, NO --borde.

     Con --borde daba 1,23:1 en claro y 1,72:1 en oscuro: no se veia, y
     como el hueco vacio encima del h2 era el mismo que encima del h3
     (48px los dos), el corte de seccion se quedaba sin ninguna señal
     propia. Con --chip-borde son 2,02:1 y 3,09:1: se lee como regla
     sin convertirse en tinta.

     Y va en 1px, no en 2. En este diseño el 2px ya significa otra
     cosa: es el borde de los grupos de chips de la cabecera. Engrosar
     esta linea la convertiria en elemento decorativo en vez de
     estructura. Si hiciera falta mas presencia, la respuesta es el
     numero de seccion de mas abajo, no una linea mas gorda. */
  .prosa :global(h2) {
    margin-top: var(--h2-arriba);
    margin-bottom: var(--h2-abajo);
    padding-top: var(--h2-aire-linea);
    border-top: 1px solid var(--chip-borde);
    color: var(--texto);
  }

  /* ======================================================================
     NUMERO DE SECCION

     Un 01..08 en acento encima de cada h2. Sale de un contador CSS, asi
     que el Markdown no lleva ningun numero escrito a mano y renumerar
     al reordenar secciones es automatico.

     POR QUE UN NUMERO Y NO MAS AIRE. El aire y la linea son la misma
     clase de señal que usa el resto de la pagina, y el h3 ya se lleva
     48px. El numero es lo unico que no aparece en ningun otro lugar
     del cuerpo del lab: una marca de color con forma de numeral. Es lo
     que engancha el ojo yendo rapido, y de paso dice cuantas secciones
     quedan sin tener que mirar el indice.

     VA ENCIMA DEL TITULO, no colgando en el canalon como el marcador
     del h3. No es estetica: "01" mide 16px a 12px de cuerpo y colgarlo
     a la izquierda necesitaria 28px de canalon; en movil el canalon es
     el relleno del contenedor, que son 24px. No cabe.

     SOLO EN LABS LARGOS, por eso cuelga de .lab--con-toc. Es el mismo
     umbral que decide la tabla de contenidos, y por el mismo motivo:
     numerar seis secciones que entran en tres pantallas es decoracion,
     no orientacion. Los dos auxiliares de navegacion aparecen y
     desaparecen juntos.

     El acento en el numero es su QUINTO uso en el sitio, y esta dentro
     de la regla de moderacion: cae en la misma familia que el marcador
     del h3 y la barra del indice activo, acento chico que marca
     posicion estructural. Nunca decoracion.

     Comprobado en el arbol de accesibilidad de Chrome: el contenido
     generado NO entra en el nombre del encabezado. El h2 se sigue
     llamando "Contexto" y no "01 Contexto", asi que el texto del
     encabezado y el del indice siguen siendo el mismo. Si algun
     navegador lo incluyera, la red de seguridad es una linea:
     content: counter(...) / "" deja el texto alternativo vacio.
     ====================================================================== */
  .lab--con-toc .prosa {
    counter-reset: seccion;
  }

  .lab--con-toc .prosa :global(h2)::before {
    counter-increment: seccion;
    /* decimal-leading-zero da 01 y no 1: dos digitos siempre, asi la
       columna de numeros no baila entre la seccion 9 y la 10. */
    content: counter(seccion, decimal-leading-zero);
    display: block;
    margin-bottom: var(--e-2);
    font-size: var(--t-xs);
    font-weight: 700;
    /* Pisa el letter-spacing negativo que traen h1, h2 y h3 de
       global.css, que en un numeral chico lo unico que hace es
       apretarlo. */
    letter-spacing: 0.08em;
    color: var(--acento);
  }

  /* El primer encabezado no necesita separarse de nada: viene justo
     después de la cabecera del lab, que ya trae su propia línea. */
  .prosa > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  /* El h3 baja de peso Y de color respecto al h2. Las dos cosas juntas
     lo dejan leíble como subordinado sin necesidad de compararlo con
     nada: 550 contra 650 de peso, y --texto-medio contra --texto. */
  .prosa :global(h3) {
    position: relative;
    margin-top: var(--h3-arriba);
    margin-bottom: var(--h3-abajo);
    font-weight: 550;
    color: var(--texto-medio);
  }

  /* Marcador de posición del h3: una barra corta de acento, del alto
     del texto, que ancla el encabezado a su bloque. Sirve para escanear
     la página: los h3 se detectan sin leerlos.

     Va colgando FUERA de la columna de texto (left negativo) para que el
     h3 siga alineado con el cuerpo; si usara border-left, el texto se
     correría a la derecha y rompería esa alineación. El desplazamiento
     cae dentro del padding del contenedor, así que no desborda ni en
     pantallas de 360px.

     El h2 NO lleva marcador: ya tiene su línea separadora, y sumarle
     una segunda señal lo acercaría visualmente al h3 en vez de
     distinguirlo. */
  .prosa :global(h3)::before {
    content: '';
    position: absolute;
    left: calc(var(--e-3) * -1);
    top: 0.22em;
    width: 3px;
    height: 0.95em;
    border-radius: 2px;
    background: var(--acento);
  }

  /* --- Lo que sigue a un encabezado ---
     No aporta su propio margen de arriba: el único hueco que manda es el
     margen de abajo del encabezado. Es lo que lo mantiene pegado a su
     contenido.

     OJO CON LA ESPECIFICIDAD. `.prosa p`, `.prosa pre` y `.prosa table`
     traen `margin-block`, que también fija el margen de arriba, y tienen
     la MISMA especificidad que una regla `h3 + *`. La versión anterior
     usaba `h3 + *` y quedaba declarada antes que ellas, o sea que las
     otras ganaban por orden: el hueco bajo un h3 seguido de un bloque de
     código era de 24px en vez de 8px, y el encabezado flotaba entre su
     sección y la anterior.

     Nombrar los dos lados con :is() suma un elemento más al selector y
     gana por especificidad, sin depender de dónde quede escrita. */
  .prosa
    :global(:is(h2, h3) + :is(p, ul, ol, pre, table, blockquote, figure, hr)) {
    margin-top: 0;
  }

  /* --- Encabezados consecutivos ---
     Dos casos que el ritmo normal resuelve mal:

       h2 + h3  el h3 no debe acumular su margen grande encima del que ya
                puso el h2; queda pegado, como subtítulo de la sección.
       h3 + h3  sin esto el segundo quedaría pegado al primero.

     Un h2 después de cualquier cosa conserva su tratamiento completo
     (línea + margen grande): siempre es un corte mayor. */
  .prosa :global(h2 + h3) {
    margin-top: var(--h3-tras-h2);
  }

  .prosa :global(h3 + h3) {
    margin-top: var(--h3-tras-h3);
  }

  .prosa :global(p),
  .prosa :global(ul),
  .prosa :global(ol) {
    margin-block: var(--e-4);
  }

  .prosa :global(ul),
  .prosa :global(ol) {
    padding-left: var(--e-6);
  }

  .prosa :global(li) {
    margin-block: var(--e-2);
  }

  .prosa :global(pre) {
    margin-block: var(--e-6);
  }

  /* --- Imágenes del lab ---
     Viven en src/assets/labs/<slug>/ y se referencian con ruta relativa
     desde el .md, para que Astro las procese (WebP, dimensiones, carga
     diferida). Ver "Capturas e imágenes de un lab" en CLAUDE.md:
       ![Texto alternativo](../../assets/labs/mi-lab/captura.png)

     Las capturas tienen proporciones muy distintas: una salida de
     terminal es ancha y baja (1300x140), un diagrama de topología es
     casi cuadrado (577x439). Antes esto usaba `width: 100%`, que forzaba
     a TODAS al ancho del contenedor: el diagrama se estiraba de 577 a
     1072px, o sea que quedaba de 818px de alto Y ampliado, borroso.

     Ahora manda el tamaño natural, acotado por dos topes:
       max-width: 100%             no se sale del contenedor
       max-height: --lab-imagen-alto  no se come la pantalla

     Con `width` y `height` en auto, el navegador respeta la proporción
     al aplicar cualquiera de los dos topes: no deforma ni recorta, solo
     escala. Las anchas y bajas no se ven afectadas, porque el que las
     limita sigue siendo el ancho. */
  .prosa :global(figure) {
    margin: var(--e-8) 0;
  }

  .prosa :global(img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--lab-imagen-alto);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
  }

  .prosa :global(figcaption),
  .prosa :global(img + em) {
    display: block;
    margin-top: var(--e-2);
    font-size: var(--t-sm);
    color: var(--texto-suave);
  }

  /* --- Bloque de hallazgo ---
     En un lab el blockquote NO es una cita: marca el hallazgo clave de
     una sección. Qué arrojó un escaneo, la evidencia de que un control
     quedó funcionando. Antes se veía casi igual que un párrafo (mismo
     tamaño, y encima atenuado con --texto-suave) y esos hallazgos
     pasaban desapercibidos al escanear la página.

     Tres señales: fondo propio, barra de acento y tamaño intermedio.

     Lo del tamaño es deliberado: 18px queda por encima del cuerpo (16px)
     y por debajo del h3 (21px). Destaca al escanear sin competir con la
     estructura de encabezados ni parecer un título.

     Y el color del texto vuelve a --texto: atenuarlo era justamente lo
     que lo hacía desaparecer.

     Contraste del texto sobre el fondo: 16.21:1 en claro, 10.00:1 en
     oscuro. Los dos muy por encima del mínimo 4.5:1. */
  .prosa :global(blockquote) {
    /* margin-inline: 0 NO es redundante.
       El navegador le aplica al blockquote un `margin-inline: 40px` por
       su cuenta, en su hoja de estilos por defecto. Fijar solo
       `margin-block` deja ese valor vivo, y el bloque arranca 40px a la
       derecha del párrafo y del bloque de código que tiene al lado.
       Con esto el borde izquierdo del bloque queda alineado con el del
       resto del cuerpo del lab. */
    margin-block: var(--e-6);
    margin-inline: 0;

    padding: var(--e-3) var(--e-4);
    border-left: 2px solid var(--acento);
    border-radius: 0 var(--radio) var(--radio) 0;
    background: var(--hallazgo-fondo);
    color: var(--texto);

    /* Mismo tamaño que el cuerpo. Lo que lo hace destacar es el fondo y
       la barra de acento, no el tamaño: a 18px competía con el h3 (21px)
       y el ojo lo leía como si fuera otro nivel de encabezado. */
    font-size: var(--t-base);
  }

  /* El primer y el último párrafo de adentro no aportan margen propio:
     el padding del bloque ya da todo el aire que hace falta. Sin esto el
     bloque queda con el doble de espacio arriba y abajo del texto. */
  .prosa :global(blockquote > :first-child) {
    margin-top: 0;
  }

  .prosa :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .prosa :global(hr) {
    margin-block: var(--e-12);
    border: 0;
    border-top: 1px solid var(--borde);
  }

  .prosa :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--e-6);
    font-size: var(--t-sm);
  }

  .prosa :global(th),
  .prosa :global(td) {
    text-align: left;
    padding: var(--e-2) var(--e-3);
    border-bottom: 1px solid var(--borde);
  }

  .prosa :global(th) {
    font-weight: 600;
  }

  /* --- Bloques anchos ---
     El texto del lab queda limitado a la medida de lectura por la regla
     de global.css. Estos tres se liberan de ese límite y pueden ocupar
     hasta el ancho del contenedor:

       - los bloques de código (pre)
       - las tablas
       - los párrafos que contienen una imagen

     Markdown envuelve las imágenes en un <p>, así que hay que soltar ese
     párrafo (:has(img)) y no la imagen: si solo soltáramos la imagen,
     seguiría encerrada en un padre de 70ch. */
  .prosa :global(pre),
  .prosa :global(table),
  .prosa :global(figure),
  .prosa :global(p:has(img)) {
    max-width: none;
  }
</style>
