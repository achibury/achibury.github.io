---
/**
 * Layout base: el <html> completo que envuelve TODAS las páginas.
 *
 * Cada página del sitio se escribe adentro de este componente, así que
 * lo que cambies acá (header, footer, metadatos) se aplica a todo el
 * portafolio de una sola vez.
 *
 * El <slot /> más abajo es el hueco donde Astro inserta el contenido
 * propio de cada página.
 */
import Header from '../components/Header.astro';
import DatosEstructurados from '../components/DatosEstructurados.astro';
import { AUTOR } from '../lib/sitio';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
  /**
   * Valor de og:type. Por defecto 'website', que es lo correcto para el
   * home, los listados y las páginas fijas. Las páginas de lab pasan
   * 'article' porque son contenido fechado y con autor, y las redes las
   * tratan distinto.
   */
  tipoOG?: 'website' | 'article';
  /**
   * Objeto JSON-LD (schema.org) para esta página, si corresponde. Lo
   * arma quien conoce los datos —Lab.astro con el frontmatter del lab,
   * sobre-mi.astro con el perfil— y acá solo se emite en el <head>.
   * Las páginas que no lo pasan no generan el bloque.
   */
  datosEstructurados?: Record<string, unknown>;
}

const { titulo, descripcion, tipoOG = 'website', datosEstructurados } = Astro.props;

const tituloCompleto = `${titulo} · ${AUTOR}`;

/**
 * URL absoluta de ESTA página.
 *
 * `Astro.url` es la dirección que se está generando y `Astro.site` es el
 * `site` de astro.config.mjs (https://achibury.github.io). Combinarlas da
 * la URL absoluta y completa, que es lo que exigen tanto la etiqueta
 * canonical como Open Graph: una ruta relativa ahí no sirve.
 *
 * Se calcula por página, no se escribe a mano: si mañana cambia el
 * dominio, cambia en un solo lugar y todas las páginas lo siguen.
 */
const urlCanonica = new URL(Astro.url.pathname, Astro.site);

/**
 * Imagen de vista previa, la misma para todo el sitio.
 *
 * Tiene que ser una URL ABSOLUTA: LinkedIn, WhatsApp y compañía leen la
 * etiqueta desde sus propios servidores, donde una ruta como "/og.png" no
 * significa nada. Por eso se arma con Astro.site en vez de escribirla a mano.
 *
 * El archivo se genera con `node scripts/generar-og.mjs`.
 */
const urlImagenOG = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Monograma BA. public/favicon.svg lo GENERA
         `node scripts/generar-logo.mjs` desde src/lib/logo.ts, la misma
         fuente que el logo del header, asi que no se pueden
         desincronizar. Es la version con envase cuadrado redondeado, que
         a 16px deja 16% mas de alto de letra que el circulo.

         Se sirve solo el SVG: un .ico aparte seria otro archivo que
         mantener sincronizado, y todos los navegadores en uso soportan
         favicons en SVG. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    <meta name="author" content={AUTOR} />

    {/* La dirección "oficial" de esta página. Le dice a los buscadores
        cuál es la versión buena si llegan por una URL con parámetros o
        con barra final distinta, para que no la cuenten dos veces. */}
    <link rel="canonical" href={urlCanonica} />

    {/* Open Graph: lo que leen LinkedIn, WhatsApp, Slack y compañía para
        armar la tarjeta de vista previa cuando alguien comparte el enlace.
        Sin esto se ve la URL pelada, sin título ni descripción.

        Título y descripción salen de las props de cada página, no son
        valores fijos: cada lab comparte su propio título y resumen.

        La imagen es fija para todo el sitio (public/og.png, 1200×630).
        Podría generarse una por lab con el título dibujado encima, pero
        eso pide una dependencia de dibujo y una ruta que la sirva; para
        un portafolio de este tamaño no compensa. */}
    {/* website en las páginas normales, article en las de lab. Lo pasa
        Lab.astro; el resto usa el valor por defecto. */}
    <meta property="og:type" content={tipoOG} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:title" content={tituloCompleto} />
    {descripcion && <meta property="og:description" content={descripcion} />}
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={AUTOR} />
    <meta property="og:image" content={urlImagenOG} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      {/* Sigue al texto del PNG, que dice "Portafolio de Ciberseguridad".
          El alt describe la imagen, asi que tiene que decir lo que la
          imagen dice. Ojo: la og:description es otra cosa y SI lleva
          "defensiva" a proposito, para posicionar por ese termino. */}
      content={`${AUTOR} — Portafolio de Ciberseguridad`}
    />

    {/* Twitter/X usa su propio juego de etiquetas. `summary_large_image`
        es la tarjeta con la imagen grande arriba, que es la que
        corresponde ahora que hay og:image de 1200×630. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    {descripcion && <meta name="twitter:description" content={descripcion} />}
    <meta name="twitter:image" content={urlImagenOG} />

    {/* Datos estructurados. Son datos inertes, no código: el navegador
        no ejecuta nada de lo que hay dentro de un ld+json, así que no
        agregan JavaScript al cliente. Sirven para que el buscador tenga
        el autor y la fecha de forma explícita en vez de adivinarlos. */}
    {datosEstructurados && <DatosEstructurados datos={datosEstructurados} />}

  </head>

  <body>
    {/* Primer elemento enfocable de la página: deja saltar el header y
        caer directo en el contenido. Solo se ve al recibir el foco; con
        el mouse no aparece nunca. Ver `.saltar` en global.css. */}
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <div class="armazon">
      <Header />
      <main id="contenido">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
