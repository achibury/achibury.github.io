---
/**
 * Tarjeta que resume un lab en un listado.
 *
 * Se usa en dos lugares: la home (últimos 3) y /labs (todos). Al estar
 * en un componente, si mañana quieres cambiar cómo se ve un lab en las
 * listas, lo cambias una vez acá y se actualiza en los dos lados.
 */
import type { Lab } from '../lib/labs';
import { ETIQUETAS_CATEGORIA, formatearFecha } from '../lib/labs';

interface Props {
  lab: Lab;
}

const { lab } = Astro.props;
const { titulo, resumen, fecha, categoria, borrador } = lab.data;
---

<article class="tarjeta">
  <div class="tarjeta__meta">
    <span class="etiqueta etiqueta--acento">{ETIQUETAS_CATEGORIA[categoria]}</span>
    <!-- <time> con datetime en formato ISO: legible para personas,
         interpretable para máquinas. -->
    <time class="meta" datetime={fecha.toISOString()}>{formatearFecha(fecha)}</time>
    {
      /* Este aviso solo puede aparecer en `npm run dev`: en producción
         los borradores ni siquiera llegan a esta tarjeta. */
      borrador && <span class="etiqueta">Borrador</span>
    }
  </div>

  <h3 class="tarjeta__titulo">
    <!-- El enlace envuelve solo el título, pero el ::after de más abajo
         lo estira sobre toda la tarjeta para que sea clickeable entera
         sin anidar enlaces (que rompe la accesibilidad). -->
    <a href={`/labs/${lab.id}/`}>{titulo}</a>
  </h3>

  <p class="texto-suave">{resumen}</p>
</article>

<style>
  /* --- Ritmo de la tarjeta ---
     Las tres líneas (metadatos, título, resumen) van muy juntas entre sí
     y la tarjeta entera lleva mucho aire arriba y abajo. Esa diferencia
     (0.5rem adentro contra 2rem afuera, cuatro veces más) es lo que hace
     que las tres se lean como una unidad y no como tres líneas sueltas
     de una lista continua.

     La línea superior marca dónde empieza cada entrada. */
  .tarjeta {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    padding-block: var(--e-8);
    border-top: 1px solid var(--borde);
  }

  /* Cierra la última entrada: sin esto el listado queda abierto abajo y
     no se ve dónde termina. */
  .tarjeta:last-child {
    border-bottom: 1px solid var(--borde);
  }

  .tarjeta__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-3);
  }

  .tarjeta__titulo {
    margin: 0;
  }

  .tarjeta__titulo a {
    color: var(--texto);
    text-decoration: none;
  }

  .tarjeta__titulo a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tarjeta:hover .tarjeta__titulo a {
    color: var(--acento);
  }

  .tarjeta p {
    margin: 0;
  }
</style>
