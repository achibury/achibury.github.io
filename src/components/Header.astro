---
/**
 * Encabezado con la navegación principal.
 *
 * La marca de la izquierda es el enlace al home: por eso "Inicio" no
 * está en el menú. El nombre en texto se reemplazó por el monograma; el
 * dibujo sale de src/lib/logo.ts, que es la fuente única de la marca.
 *
 * Va a 26px de alto. El header medía 56,8px (14px x 1,7 de línea + 16
 * de relleno arriba y abajo + 1 de borde) y pasa a 59px, porque la fila
 * mide lo que mida el elemento más alto. Ese relleno NO es holgura: todo
 * píxel que el logo pase de 23,8 estira el header uno a uno.
 *
 * El nombre accesible lo pone el aria-label del enlace, y el SVG va con
 * aria-hidden para que no se anuncie dos veces.
 *
 * Los enlaces salen del array `enlaces`: para agregar una sección al
 * menú, agregas un objeto acá y listo, no hay que tocar el HTML.
 *
 * `Astro.url.pathname` es la URL de la página que se está mostrando.
 * La comparamos con cada enlace para marcar en cuál sección estás
 * parado (visualmente y con aria-current, que lo anuncian los
 * lectores de pantalla).
 */
import Logo from './Logo.astro';

const enlaces = [
  { href: '/labs/', texto: 'Labs' },
  { href: '/sobre-mi/', texto: 'Sobre mí' },
];

const rutaActual = Astro.url.pathname;

function esActivo(href: string): boolean {
  // startsWith para que /labs/mi-lab también marque "Labs" como activo.
  return rutaActual.startsWith(href);
}
---

<header class="encabezado">
  <div class="contenedor encabezado__interior">
    <a class="encabezado__marca" href="/" aria-label="Inicio — Benjamin Achibury">
      <Logo alto={26} />
    </a>

    <nav aria-label="Navegación principal">
      <ul class="encabezado__lista">
        {
          enlaces.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                class:list={['encabezado__enlace', { 'es-activo': esActivo(enlace.href) }]}
                aria-current={esActivo(enlace.href) ? 'page' : undefined}
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Los estilos dentro de <style> en un .astro solo afectan a ESTE
     componente. Astro le agrega una clase única a cada elemento para
     que no se filtren al resto del sitio. */
  .encabezado {
    border-bottom: 1px solid var(--borde);
  }

  .encabezado__interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3) var(--e-8);
    padding-block: var(--e-4);
  }

  /* El enlace de la marca.

     `display: flex` no es decorativo: un <svg> es inline por defecto y
     se apoya en la línea de base, lo que agrega unos píxeles de hueco
     abajo por el espacio de los descendentes y descuadra el centrado
     contra el menú. Con flex el SVG deja de ser inline y el hueco
     desaparece.

     El `color` es lo que pinta las letras del monograma: el SVG las
     dibuja con `currentColor`, así que hereda de acá y el hover las
     aclara igual que a los enlaces del menú. El trapecio no cambia:
     va en --acento. */
  .encabezado__marca {
    display: flex;
    color: var(--texto-suave);
    text-decoration: none;
  }

  .encabezado__marca:hover {
    color: var(--texto);
  }

  /* GAP DE 20px, que la escala no tiene.

     La escala salta de --e-4 (16px) a --e-6 (24px) y los dos extremos
     fallan: con 16 los enlaces se aprietan entre si, y con 24 el grupo
     vuelve a leerse como tres elementos sueltos en vez de un bloque que
     le haga contrapeso al logo. 20 es el punto donde respiran sin
     desarmarse, y sale de sumar dos tokens en vez de escribir un pixel
     suelto.

     NO lo bajes a --e-4 "para ganar espacio en movil". Esta medido con
     Segoe UI a 14px en peso 600: a 360px hay 312px disponibles (360
     menos 24 de relleno por lado) y el header ocupa 177 con este gap
     (logo 40 + hueco 32 + menu 105), o sea 135px de holgura. Incluso con
     24 sobran 131. El ancho nunca fue la restriccion — yo mismo lo aprete
     a 16 creyendo que si, y lo unico que consegui fue el apretujamiento.

     La medicion cambio tres veces: con los tres enlaces originales el
     menu media 211px; al borrar la pagina de herramientas bajo a 105; al
     agregar "Contacto" subio a 183, y al sacarlo volvio a 105. "Contacto"
     se revirtio porque la etiqueta y el destino no coincidian, no por el
     ancho: ver la nota del header en CLAUDE.md. */
  .encabezado__lista {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--e-4) + var(--e-1));
    margin: 0;
    padding: 0;
    font-size: var(--t-sm);
  }

  /* PESO 600, no 500.

     Ojo con esto: la fuente del sitio resuelve a Segoe UI en Windows, y
     Segoe UI NO tiene peso 500. Por las reglas de emparejamiento de CSS
     un `font-weight: 500` cae a Regular y no se ve ningun cambio. Esta
     medido: "Herramientas" a 14px mide 81px de tinta tanto a 400 como a
     500, y 84px a 550 y a 600. Los pesos que existen de verdad son
     300 / 350 / 400 / 600 / 700, asi que el unico escalon real hacia
     arriba desde Regular es Semibold.

     Va en 600 para que el menu le haga contrapeso optico al logo. El
     logo son 26px de caja entintada entera; el texto a 14px tiene mucho
     aire interno y las mayusculas miden ~10px, asi que a peso normal el
     header quedaba cargado a la izquierda. El peso es lo que arregla eso:
     el color se dejo como estaba a proposito, ver abajo. */
  .encabezado__enlace {
    color: var(--texto-suave);
    font-weight: 600;
    text-decoration: none;
  }

  .encabezado__enlace:hover {
    color: var(--texto);
  }

  /* El activo se distingue por DOS señales, peso y color, y las dos
     tienen que sobrevivir a cualquier cambio del estado de reposo.

     Por eso el reposo se quedo en --texto-suave. Subirlo a --texto-medio
     equilibraba un poco mas el header, pero achicaba la separacion de
     color contra el activo de 2.36:1 a 1.72:1 en claro y de 2.08:1 a
     1.48:1 en oscuro — medido, no estimado. El activo dejaba de saltar a
     la vista. El peso ya resuelve el equilibrio sin ese costo.

     700 y no 550: 550 ya renderizaba como Semibold (600), asi que con el
     reposo en 600 habrian quedado identicos. */
  .encabezado__enlace.es-activo {
    color: var(--texto);
    font-weight: 700;
  }
</style>
